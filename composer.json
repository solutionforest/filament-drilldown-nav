{
    "name": "solutionforest/filament-drilldown-nav",
    "description": "Drill-down (slide) multi-level sidebar navigation for Filament v5 panels.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.10",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "larastan/larastan": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "SolutionForest\\DrilldownNav\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SolutionForest\\DrilldownNav\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SolutionForest\\DrilldownNav\\DrilldownNavServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
