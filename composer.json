{
    "name": "solutionforest/filament-drilldown-nav",
    "description": "Drill-down sidebar navigation for Filament v5 panels: one level at a time, a menu per record, any depth.",
    "keywords": [
        "filament",
        "filament-plugin",
        "filamentphp",
        "filament-v5",
        "laravel",
        "livewire",
        "navigation",
        "sidebar",
        "drilldown",
        "octane"
    ],
    "homepage": "https://github.com/solutionforest/filament-drilldown-nav",
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/solutionforest/filament-drilldown-nav/issues",
        "source": "https://github.com/solutionforest/filament-drilldown-nav",
        "docs": "https://github.com/solutionforest/filament-drilldown-nav/tree/main/docs",
        "security": "https://github.com/solutionforest/filament-drilldown-nav/security/policy"
    },
    "authors": [
        {
            "name": "Solution Forest",
            "homepage": "https://github.com/solutionforest"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.7",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "larastan/larastan": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "SolutionForest\\DrilldownNav\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SolutionForest\\DrilldownNav\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SolutionForest\\DrilldownNav\\DrilldownNavServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
